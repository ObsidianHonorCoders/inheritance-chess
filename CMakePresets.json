{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON",
        "EXE_NAME": "ichess_runner"
      }
    },
    {
      "name": "ci",
      "displayName": "CI Release",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TESTS": "ON",
        "EXE_NAME": "ichess_runner"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-build",
      "displayName": "Build Developer Debug",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "ci-build",
      "displayName": "Build CI Release",
      "configurePreset": "ci",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-test",
      "displayName": "CTest Developer Debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-test",
      "displayName": "CTest CI Release",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
